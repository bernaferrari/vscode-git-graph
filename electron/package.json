{
    "name": "electron-vite-react-template",
    "private": true,
    "version": "0.0.0-alpha.1+custom-extra-name",
    "description": "Base Electron + Vite + React template with tRPC IPC, TanStack Router/Query/Form/Virtual, and TailwindCSS",
    "author": "",
    "type": "module",
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:win": "vite build && electron-builder --win -c electron-builder.json5",
        "build:mac": "vite build && electron-builder --mac -c electron-builder.json5",
        "build:linux": "vite build && electron-builder --linux -c electron-builder.json5",
        "publish:generic": "tsx scripts/publish.ts",
        "typecheck": "tsr generate && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.node.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@base-ui/react": "^1.1.0",
        "@fontsource-variable/inter": "^5.2.8",
        "@hugeicons/core-free-icons": "^3.1.1",
        "@hugeicons/react": "^1.1.5",
        "@pierre/diffs": "^1.0.10",
        "@radix-ui/react-context-menu": "^2.2.16",
        "@tanstack/react-form": "^1.28.0",
        "@tanstack/react-query": "^5.90.20",
        "@tanstack/react-router": "^1.159.5",
        "@tanstack/react-virtual": "^3.13.18",
        "@trpc/client": "^11.9.0",
        "@trpc/react-query": "^11.9.0",
        "@trpc/server": "^11.9.0",
        "arktype": "^2.1.29",
        "chokidar": "^5.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.1.0",
        "electron-store": "^11.0.2",
        "electron-trpc-experimental": "1.0.0-alpha.1",
        "iconv-lite": "^0.7.2",
        "lucide-react": "^0.563.0",
        "mutative": "^1.3.0",
        "next-themes": "^0.4.6",
        "react": "^19.2.4",
        "react-day-picker": "^9.13.1",
        "react-dom": "^19.2.4",
        "react-icons": "^5.5.0",
        "recharts": "3.7.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.4.0",
        "vaul": "^1.1.2",
        "zod": "^4.3.6",
        "zustand": "^5.0.11"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.58.2",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/eslint-plugin-query": "^5.91.4",
        "@tanstack/react-devtools": "^0.9.5",
        "@tanstack/react-form-devtools": "^0.2.13",
        "@tanstack/react-query-devtools": "^5.91.3",
        "@tanstack/react-router-devtools": "^1.159.5",
        "@tanstack/router-cli": "^1.159.4",
        "@tanstack/router-plugin": "^1.159.5",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^25.2.2",
        "@types/react": "^19.2.13",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.3",
        "@vitest/eslint-plugin": "^1.6.6",
        "babel-plugin-react-compiler": "^1.0.0",
        "dotenv": "^17.2.4",
        "electron": "^40.2.1",
        "electron-builder": "^26.7.0",
        "electron-updater": "^6.7.3",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-n": "^17.23.2",
        "eslint-plugin-no-secrets": "^2.2.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.0",
        "eslint-plugin-security": "^3.0.1",
        "globals": "^17.3.0",
        "happy-dom": "^20.6.1",
        "msw": "^2.12.10",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "shadcn": "^3.8.4",
        "tailwind-clamp": "^4.1.2",
        "tailwindcss": "^4.1.18",
        "tsx": "^4.21.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.55.0",
        "vite": "^7.3.1",
        "vite-plugin-electron": "^0.29.0",
        "vite-tsconfig-paths": "^6.1.0",
        "vitest": "^4.0.18"
    }
}
