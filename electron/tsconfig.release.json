        "src/components/git-graph/external-diff-tool.tsx",
        "src/components/git-graph/file-annotations-panel.tsx",
        "src/components/git-graph/file-tree.tsx",
        "src/components/git-graph/fuzzy-finder.tsx",
        "src/components/git-graph/git-bisect-ui.tsx",
        "src/components/git-graph/git-config-editor.tsx",
        "src/components/git-graph/gitflow-automation.tsx",
        "src/components/git-graph/gitflow-panel.tsx",
        "src/components/git-graph/gitflow-toolbar.tsx",
        "src/components/git-graph/gitignore-manager.tsx",
        "src/components/git-graph/inline-blame.tsx",
        "src/components/git-graph/inline-staging-diff.tsx",
