{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "strict": false,
        "verbatimModuleSyntax": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "exactOptionalPropertyTypes": false
    },
    "include": [
        "src/trpc/**/*.ts",
        "src/hooks/useGitOperations.ts",
        "src/lib/store.ts",
        "src/lib/operationLog.ts",
        "src/components/git-graph/**/*.ts",
        "src/components/git-graph/**/*.tsx",
        "electron/backend/**/*.ts",
        "electron/main.ts",
        "electron/preload.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "dist-electron",
        "**/*.test.ts",
        "**/*.test.tsx",
        "electron/backend/trpc/routers/git/preview-procedures.ts",
        "src/components/ai/**",
        "src/components/lens/**",
        "src/components/plan-editor/**",
        "src/components/what-if/**",
        "src/components/commit-series/**",
        "src/components/component-example.tsx",
        "src/components/git-graph/avatar.tsx",
        "src/components/git-graph/branch-compare.tsx",
        "src/components/git-graph/branch-comparison.tsx",
        "src/components/git-graph/custom-commands.tsx",
        "src/components/git-graph/drag-commit-to-branch.tsx",
