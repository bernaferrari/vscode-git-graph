{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "strict": true,
        "verbatimModuleSyntax": false,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "exactOptionalPropertyTypes": true
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "electron/**/*.ts",
        "electron/**/*.tsx",
        "vite.config.ts",
        "playwright.config.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "dist-electron",
        "**/*.test.ts",
        "**/*.test.tsx"
    ]
}
